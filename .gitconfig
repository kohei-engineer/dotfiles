[include]
	path = ~/.config/git/user.local

[core]
	editor = vim
	quotepath = false

[pull]
	rebase = true

[diff]
	tool = vimdiff-zoom

[difftool]
	prompt = false

# Zoom the WezTerm pane while vimdiff runs, then restore it.
# Outside WezTerm, this runs as a normal vimdiff.
[difftool "vimdiff-zoom"]
	cmd = "if [ -n \"$WEZTERM_PANE\" ]; then wezterm cli zoom-pane --pane-id \"$WEZTERM_PANE\" --zoom; fi; vim -d \"$LOCAL\" \"$REMOTE\"; ret=$?; if [ -n \"$WEZTERM_PANE\" ]; then wezterm cli zoom-pane --pane-id \"$WEZTERM_PANE\" --unzoom; fi; exit $ret"
